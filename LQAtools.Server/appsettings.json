{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Enabled": true,
    "AllowUserOverride": false,
    "AllowedGroup": ""
  },
  "Security": {
    "RequireHttpsForRemote": true,
    "AllowInsecureRemote": false,
    "AllowedHosts": []
  },
  "ConnectionStrings": {
    "Default": "Data Source=Storage/lqatools.db"
  },
  "Storage": {
    "BlobRoot": "Storage/blobs"
  }
}
